# --- Signaling server ---
HELUCRYPTIC_SIGNALING_URL=ws://127.0.0.1:8000
HELUCRYPTIC_SERVER_PASSWORD=
# Log level for the signaling server (DEBUG, INFO, WARNING, ERROR). The server
# logs usernames and room IDs at INFO; set WARNING to keep those out of logs.
HELUCRYPTIC_LOG_LEVEL=INFO

# --- Performance ---
HELUCRYPTIC_LOW_PERF_MODE=false
HELUCRYPTIC_SCREEN_MAX_WIDTH=1280
HELUCRYPTIC_SCREEN_MAX_HEIGHT=720
HELUCRYPTIC_SCREEN_FPS=15
HELUCRYPTIC_JPEG_QUALITY=55
HELUCRYPTIC_TILE_RENDER_FPS=10

# --- TURN relay -------------------------------------------------------------
# CLIENT side. Peers behind carrier-grade / symmetric NAT have no direct UDP
# path to each other, so without a relay only text chat works (it rides the
# signaling WebSocket) while calls, screen share and file transfer fail. Set
# these to point at your own relay; leaving them empty is fine when the
# signaling server mints credentials (see the SERVER block below), which the
# client fetches automatically at GET <signaling-url>/turn.
HELUCRYPTIC_TURN_URL=
HELUCRYPTIC_TURN_USERNAME=
HELUCRYPTIC_TURN_PASSWORD=
# Public last-resort relay when nothing else is configured. The bundled
# openrelayproject credentials are rate-limited and frequently dead - treat this
# as a courtesy, not a working relay. Set false to skip the gathering delay.
HELUCRYPTIC_TURN_FALLBACK=true
HELUCRYPTIC_TURN_FALLBACK_USERNAME=
HELUCRYPTIC_TURN_FALLBACK_CREDENTIAL=

# SERVER side (server.py / the Cloudflare Worker only - never ship these in a
# client build). Whichever pair is set selects the provider, first match wins;
# see docs/TURN_SETUP.md.
#
# 1. Cloudflare Realtime TURN - 1 TiB/month free, UDP + TCP + TLS.
HELUCRYPTIC_CF_TURN_KEY_ID=
HELUCRYPTIC_CF_TURN_API_TOKEN=
# 2. Self-hosted coturn with `use-auth-secret` (time-limited credentials).
#    Reuses HELUCRYPTIC_TURN_URL above as the relay address.
HELUCRYPTIC_TURN_STATIC_SECRET=
# 3. Nothing extra - HELUCRYPTIC_TURN_URL/_USERNAME/_PASSWORD are handed out
#    verbatim to every client.

# --- Port forwarding (optional) ---
HELUCRYPTIC_PORT_FORWARD_ENABLED=false
HELUCRYPTIC_FORWARDED_PORT=0
