dist
build
cloudflare/.wrangler
__pycache__
.pytest_cache
.pytest-tmp-*
.env
*.spec.bak
# PyInstaller spec is generated by build.py; keep ignore for all specs except the
# example Helucryptic.spec which is intentionally tracked for reference
*.spec
!Helucryptic.spec

# OneDrive/Explorer folder-metadata droppings (corrupt .git refs if synced)
desktop.ini
*.txt
# ...but requirements.txt is a real tracked file, not a dropping.
!requirements.txt
*.venv
.build-venv/
.venv/
*.egg-info/
.mypy_cache/
.pyrefly/
*.vscode
.ruff_cache
.scannerwork
.sonarqube
.agent
.scannerwork/*
.sonarqube/*
.agent/*
.superpowers/*

# Ignore the whole docs/ tree EXCEPT the checked-in feature spec.
# NOTE: the exception must come AFTER the ignore, and the ignore must use
# docs/* (not docs/) - a file cannot be re-included once its parent directory
# is itself excluded.
docs/*
!docs/FEATURE_SPEC.md
